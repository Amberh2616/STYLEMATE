{
  "extends": [
    "next/core-web-vitals",
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "off",
    "react/no-unescaped-entities": "off"
  },
  "ignorePatterns": ["node_modules", ".next", "out"]
}