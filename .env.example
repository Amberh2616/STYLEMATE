# 必填（主搜尋供應商）
BING_KEY=your_bing_search_v7_api_key_here

# 可選（備援搜尋供應商）
TAVILY_KEY=your_tavily_api_key_here

# 可選（Google 搜尋，需要時啟用）
SERP_API_KEY=your_serpapi_key_here

# WebSearch 服務端口
PORT=3005

# OpenAI API（現有系統）
OPEN_AI_API_KEY=your_openai_api_key_here

# PostgreSQL 資料庫（現有系統）
DATABASE_URL=postgresql://postgres:2616@localhost:5432/stylemate_fashion

# 其他服務端口
FASHION_CLIP_PORT=3003
MAIN_APP_PORT=3004