{
  "manifest_version": 3,
  "name": "Affiora Virtual Try-On Assistant",
  "version": "1.0",
  "description": "AI-powered virtual fashion try-on using Google Gemini AI (Nano Banana). Right-click on clothing images to try them on instantly.",

  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["activeTab", "storage", "contextMenus", "alarms"],

  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Affiora Virtual Try-On Assistant",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": ["popup.html", "icons/icon128.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
